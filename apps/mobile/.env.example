# Base URL of the LifeClick API.
#
# IMPORTANT: a physical device cannot reach "localhost" — that resolves to the
# phone itself. Use your machine's LAN address during development (for example
# http://192.168.1.20:4000) or a deployed API URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# EAS project ID, written by `eas init`. Required for push notification tokens;
# without it the app still runs and local reminders still work.
EAS_PROJECT_ID=

# Google Maps keys, baked into the binary by the react-native-maps config
# plugin. Optional during MVP: without them the native map falls back to the
# non-Google provider. Android store builds need the Android key for the
# satellite view to render. Restrict both keys to the app's bundle ID/package.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
