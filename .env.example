# ---------------------------------------------------------------- web client
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:4000

# -------------------------------------------------------------------- server
# Hosted PostgreSQL (Neon and similar). Never point Vercel at localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeclick
PORT=4000

# REQUIRED in production — the API refuses to start without it. Signs access
# tokens, so changing it invalidates every existing session.
#   Generate with: openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed to call the API, comma separated. Native apps send no
# Origin header and are unaffected. Empty in production means no browser origin
# is permitted, so set your Vercel URL here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Token lifetimes in seconds. Defaults: 1 hour access, 30 day refresh.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# bcrypt work factor.
BCRYPT_ROUNDS=12

# DANGEROUS. When true, the API issues a session for ANY credentials whenever
# the database is unreachable, so the investor prototype keeps demoing. Leave
# unset everywhere else — without it a database-less deploy fails closed (503).
ALLOW_DEMO_AUTH=

# Local dev DB only: PGlite accepts a single connection. Omit for Neon.
DB_POOL_MAX=

# ----------------------------------------------------- safety scheduler
# REQUIRED for background monitoring. Without it /api/jobs/* returns 503 and
# missed check-ins are never detected. Generate: openssl rand -hex 24
CRON_SECRET=

# Minutes between notifying the user and alerting their trusted contacts.
ESCALATION_GRACE_MINUTES=10

# ------------------------------------------------ privacy & retention
# Bump when the consent wording changes; users re-consent to the new version.
TERMS_VERSION=2026-09-11

# api_access_log is the fastest-growing table (~1,440 rows/user/day with
# background location on). Set false to stop request logging entirely.
ACCESS_LOG_ENABLED=true
SECURITY_LOG_ENABLED=true
ACCESS_LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=180
LOCATION_RETENTION_DAYS=90
